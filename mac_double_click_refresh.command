#!/bin/bash
# 定位到当前脚本所在的目录
cd "$(dirname "$0")"

echo "======================================================="
echo "🇭🇰 香港出入境客流量数据报表 - Mac 一键生成工具"
echo "======================================================="
echo ""

# 运行 Python 主程序
python3 weekly_report_data.py

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 运行出错，请检查数据文件或 Python 环境！"
    echo ""
    read -p "按回车键退出..."
    exit 1
fi

echo ""
echo "======================================================="
echo "✅ 处理完成！Excel 报表已保存，Dashboard 已在浏览器打开。"
echo "======================================================="
echo ""
read -p "按回车键退出..."